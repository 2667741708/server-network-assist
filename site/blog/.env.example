# Copy this file to `.env` and fill your deployment values.
# The prepare-cms script reads these values when generating public/admin/config.json.

BLOG_REPO=2667741708/server-network-assist
BLOG_BRANCH=main
BLOG_SITE_URL=https://whm12.art/projects/
BLOG_DISPLAY_URL=https://whm12.art/projects/

# GitHub 登录接通后开启。留空会让后台显示“未接通 OAuth 登录”。
BLOG_OAUTH_BASE_URL=https://yourdomain.example.com
BLOG_OAUTH_ENDPOINT=auth
