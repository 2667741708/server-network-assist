# Exact browser-facing origin. HTTPS is required for passkeys.
PANEL_ORIGIN=https://network.example.com
# Optional comma-separated browser origins for trusted private-network entry points.
# Password login works on HTTP; passkeys remain limited to PANEL_ORIGIN.
PANEL_ALLOWED_ORIGINS=http://10.201.250.1:9180
# Optional when publishing below an existing HTTPS site, without a trailing slash.
PANEL_BASE_PATH=/network-assist
