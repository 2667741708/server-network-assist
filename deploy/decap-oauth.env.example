# Install as /etc/decap-oauth.env with mode 0640, owner root:decap-oauth.
GITHUB_OAUTH_ID=replace-with-github-client-id
GITHUB_OAUTH_SECRET=replace-with-github-client-secret
OAUTH_PUBLIC_BASE_URL=https://whm12.art/projects/oauth
CMS_ORIGIN=https://whm12.art
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
GITHUB_OAUTH_SCOPE=public_repo,user
GITHUB_REPO=2667741708/server-network-assist
OAUTH_BIND=127.0.0.1
OAUTH_PORT=9190
